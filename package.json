{
  "name": "cap-ai-salesorder",
  "version": "3.0.0",
  "dependencies": {
    "@sap-ai-sdk/foundation-models": "^2.15.0",
    "@sap-ai-sdk/orchestration": "^2.15.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-salesorderui": "cds watch --open salesorderui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy cap-ai-salesorder --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
